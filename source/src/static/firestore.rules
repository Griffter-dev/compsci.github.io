rules_version = '2';
// CompSci-Study security rules. Paste these into Firebase → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function squad(sid) { return get(/databases/$(database)/documents/squads/$(sid)).data; }
    // ---- Owners and admins ----
    // Owners: these emails always have full access once the email is verified (Google sign-ins are verified).
    function myEmail() { return request.auth.token.get('email', '').lower(); }
    function verified() { return request.auth.token.get('email_verified', false) == true; }
    function isOwner() { return signedIn() && verified() && myEmail() in ['francescovic0525@gmail.com', '129fcapone@frhsd.com']; }
    // Admins: emails an owner adds in the app's Admin panel (stored in config/admins.emails).
    function adminDoc() { return get(/databases/$(database)/documents/config/admins).data; }
    function isAdmin() {
      return isOwner() || (signedIn() && exists(/databases/$(database)/documents/config/admins)
        && ((verified() && myEmail() in adminDoc().get('emails', [])) || request.auth.uid in adminDoc().get('uids', [])));
    }
    function isLeader(sid) { return signedIn() && (squad(sid).owner == request.auth.uid || isAdmin()); }
    function isMember(sid) { return signedIn() && (exists(/databases/$(database)/documents/squads/$(sid)/members/$(request.auth.uid)) || isAdmin()); }

    match /config/admins {
      allow read: if signedIn();
      allow write: if isOwner();
    }
    // Accounts: a public summary (name, XP...) and private saved progress
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if signedIn() && request.auth.uid == uid;
      allow delete: if isOwner();
      match /private/{doc} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }
    // Feedback: anyone can send it, and only site owners can read it
    match /feedback/{fid} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
                    && request.resource.data.message is string && request.resource.data.message.size() <= 1500
                    && request.resource.data.status == 'new';
      allow read, update, delete: if isAdmin();
    }

    // Class notes suggestions: anyone signed in can send them, and only site owners and admins can read them
    match /noteSuggestions/{nid} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
                    && request.resource.data.text is string && request.resource.data.text.size() <= 20000
                    && request.resource.data.unit is string && request.resource.data.unit.size() <= 20
                    && request.resource.data.status == 'new';
      allow read, update, delete: if isAdmin();
    }

    match /squads/{sid} {
      allow get: if signedIn();            // you must know the 6-letter code to look a squad up
      allow list: if isAdmin();            // only admins can browse all squads
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid
                    && request.resource.data.name is string && request.resource.data.name.size() <= 40;
      allow update: if isLeader(sid);
      allow delete: if isAdmin();

      match /members/{uid} {
        allow read: if isMember(sid);
        allow create, update: if signedIn() && request.auth.uid == uid
                    && !(uid in squad(sid).get('banned', []))
                    && request.resource.data.name is string && request.resource.data.name.size() <= 20;
        allow delete: if signedIn() && (request.auth.uid == uid || isLeader(sid));
      }
      match /questions/{qid} {
        allow read: if isMember(sid);
        allow create: if isMember(sid) && request.resource.data.author == request.auth.uid
                      && (request.resource.data.status == 'pending' || isLeader(sid));
        allow update: if isLeader(sid)
                      || (isMember(sid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reports']));
        allow delete: if isLeader(sid) || (signedIn() && resource.data.author == request.auth.uid);
      }
      match /duels/{did} {
        allow read, create, update: if isMember(sid);
        allow delete: if isMember(sid) && (resource.data.host == request.auth.uid || isLeader(sid));
      }
      match /assignments/{aid} {
        allow read: if isMember(sid);
        allow create, update, delete: if isLeader(sid);
      }
      match /weekly/{wid} {
        allow read: if isMember(sid);
        allow write: if isMember(sid) && request.resource.data.uid == request.auth.uid
                     && wid == request.resource.data.week + '_' + request.auth.uid;
      }
    }
  }
}
